include LICENSE README.md THIRD_PARTY_NOTICES.md uv.lock
include eval.py server.py cases.jsonl prompt.txt
include CONTRIBUTING.md SUPPORT.md SECURITY.md CODE_OF_CONDUCT.md
recursive-include docs *.md *.svg *.drawio *.png
recursive-include examples *.json *.html *.md
recursive-include scripts *.py
recursive-include tests *.py
include benchmarks/__init__.py
include benchmarks/decision_models/*.py
include benchmarks/decision_models/*.json
include benchmarks/decision_models/*.md
recursive-include benchmarks/decision_models/data *.json *.jsonl
recursive-include benchmarks/decision_models/recordings *.json *.md
include benchmarks/decision_models/runtime/pyproject.toml
include benchmarks/decision_models/runtime/uv.lock
include benchmarks/tool_workflow/*.py
include benchmarks/tool_workflow/*.md
include benchmarks/tool_workflow/*.json
recursive-include benchmarks/tool_workflow/data *.json *.jsonl
recursive-include benchmarks/tool_workflow/recordings *.json *.md
